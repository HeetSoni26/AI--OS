# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL / Supabase data platform
DATABASE_URL=postgresql://user:password@pooler-host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@direct-host:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=server-only-service-role-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
APPLICATION_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
WEBHOOK_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Optional Part 3 Gmail ingestion OAuth (separate from Supabase Google login)
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://127.0.0.1:3000/api/v1/integrations/gmail/callback
GMAIL_OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters

# Login rate limiting (required in production)
AIOS_RATE_LIMIT_BACKEND=upstash
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Owner bootstrap and environment
AIOS_OWNER_EMAIL=owner@example.com
AIOS_OWNER_AUTH_SUBJECT=00000000-0000-4000-8000-000000000000
AIOS_OWNER_DISPLAY_NAME=Agency Owner
AIOS_ENVIRONMENT=local
AIOS_AUTH_BYPASS=
AIOS_CORS_ORIGINS=http://localhost:3000

# Optional observability
SENTRY_DSN=
AXIOM_DATASET=
AXIOM_TOKEN=
